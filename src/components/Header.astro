---
import { siteConfig } from "../config";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
const hasEducation = siteConfig.education && siteConfig.education.length > 0;
---

<header
  id="header"
  class="fixed top-0 left-0 right-0 z-50 block bg-white/90 backdrop-blur-sm transition-all duration-300"
>
  <nav class="max-w-7xl mx-auto px-4 md:px-8 py-2 md:py-4">
    <ul class="flex flex-wrap items-center justify-center gap-2 text-xs md:text-base list-none">
      <li>
        <a
          href="#about"
          class="text-xs md:text-base text-gray-700 hover:text-black transition-colors font-medium px-2 py-1"
        >
          About
        </a>
      </li>

      {
        hasProjects && (
          <li>
            <a
              href="#projects"
              class="text-xs md:text-base text-gray-700 hover:text-black transition-colors font-medium px-2 py-1"
            >
              Projects
            </a>
          </li>
        )
      }

      {
        hasExperience && (
          <li>
            <a
              href="#experience"
              class="text-xs md:text-base text-gray-700 hover:text-black transition-colors font-medium px-2 py-1"
            >
              Experience
            </a>
          </li>
        )
      }

      {
        hasEducation && (
          <li>
            <a
              href="#education"
              class="text-xs md:text-base text-gray-700 hover:text-black transition-colors font-medium px-2 py-1"
            >
              Education
            </a>
          </li>
        )
      }

      <li>
        <a
          href="/resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs md:text-base text-gray-700 hover:text-black transition-colors font-medium px-2 py-1"
        >
          Resume
        </a>
      </li>

      <li>
        <a
          href="https://github.com/akarrys"
          target="_blank"
          rel="noopener noreferrer"
          class="text-xs md:text-base text-gray-700 hover:text-black transition-colors font-medium px-2 py-1"
        >
          GitHub
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  window.addEventListener("scroll", () => {
    const header = document.getElementById("header");
    if (window.scrollY > 100) {
      header?.classList.add("bg-white/80", "backdrop-blur-sm");
    } else {
      header?.classList.remove("bg-white/80", "backdrop-blur-sm");
    }
  });
</script>

<style>
  html {
    scroll-behavior: smooth;
  }
</style>
